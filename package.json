{
  "name": "codex-usage-status",
  "displayName": "Codex Usage Status",
  "icon": "media/icon.png",
  "description": "Show remaining Codex allowance and reset times in the status bar.",
  "version": "0.3.0",
  "publisher": "ZombieChamp",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZombieChamp/codex-usage-status.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test",
    "check:icons": "python3 -m unittest discover -s test -p test_icons.py",
    "package": "python3 scripts/package.py"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "codexUsage.refresh",
        "title": "Codex Usage: Refresh"
      },
      {
        "command": "codexUsage.openDashboard",
        "title": "Codex Usage: Open Usage Dashboard"
      }
    ],
    "configuration": {
      "title": "Codex Usage",
      "properties": {
        "codexUsage.executablePath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to Codex. When empty, use the installed OpenAI extension's executable or codex on PATH."
        },
        "codexUsage.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30,
          "maximum": 3600,
          "scope": "application",
          "description": "Seconds between usage checks."
        },
        "codexUsage.warningThresholdPercent": {
          "type": "number",
          "default": 66,
          "minimum": 0,
          "maximum": 100,
          "scope": "application",
          "description": "Colour an allowance yellow at this percentage remaining or less. The critical threshold takes precedence."
        },
        "codexUsage.criticalThresholdPercent": {
          "type": "number",
          "default": 33,
          "minimum": 0,
          "maximum": 100,
          "scope": "application",
          "description": "Colour an allowance red at this percentage remaining or less. Takes precedence over the warning threshold."
        }
      }
    },
    "icons": {
      "codex-usage-gauge-0": {
        "description": "Codex allowance gauge, 0% remaining.",
        "default": {
          "fontPath": "./media/gauges.woff",
          "fontCharacter": "\\E000"
        }
      },
      "codex-usage-gauge-1": {
        "description": "Codex allowance gauge, 1% remaining.",
        "default": {
          "fontPath": "./media/gauges.woff",
          "fontCharacter": "\\E001"
        }
      },
